# SID Productions: one address, HTTPS, fast assets.
# Works on Apache / LiteSpeed hosting such as Hostinger shared hosting. Ignored elsewhere.

RewriteEngine On
# 1. Always use https://siddproductions.com (no www, no http). Matches the canonical link.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://siddproductions.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.siddproductions\.com$ [NC]
RewriteRule ^ https://siddproductions.com%{REQUEST_URI} [L,R=301]

# 2. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/ld+json image/svg+xml text/xml
</IfModule>

# 3. Caching: images never change under the same name; the page itself is rechecked hourly
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

DirectoryIndex index.html

# The guest list page is now the Events page
RewriteRule ^guestlist\.html$ https://siddproductions.com/events.html [L,R=301]
# Short event links for social posts (temporary redirects, change per event)
RewriteRule ^sherlock/?$ https://siddproductions.com/events.html?only=skydeck&utm_source=social&utm_medium=organic&utm_campaign=sherlock_night [L,R=302,NE]
RewriteRule ^skydeck-night/?$ https://siddproductions.com/events.html?only=skydeck&utm_source=social&utm_medium=organic&utm_campaign=sherlock_night [L,R=302,NE]

# Let listing portals pull event card images directly
<IfModule mod_headers.c>
  <FilesMatch "^district-.*\.jpg$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
